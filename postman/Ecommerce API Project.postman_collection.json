            "exec": [
              "let jsonData = pm.response.json();\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.environment.set(\"token\", jsonData.accessToken);\n\nconsole.log(pm.environment.get(\"token\"));"
